@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Approvement_Letter</title>

    <link rel="stylesheet" href="~/css/ApprovementLetter.css" asp-append-version="true" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            var bookingId = '@Model.BookingDetails.Id';
            var bookingStartTime = '@Model.BookingDetails.startTime';
            var bookingEndTime = '@Model.BookingDetails.endTime';
            var bookingStartDate = '@Model.BookingDetails.FromDate.ToString("dd-MM-yyyy")';
            var bookingEndDate = '@Model.BookingDetails.EndDate.ToString("dd-MM-yyyy")';


            $('#receiptModal').fadeIn();

            $.ajax({
                url: '/Home/GetFacilities/' + bookingId,
                method: 'GET',
                data: {
                    bookingStartTime: bookingStartTime,
                    bookingEndTime: bookingEndTime,
                    bookingStartDate: bookingStartDate,
                    bookingEndDate: bookingEndDate
                },
                success: function (data) {
                    let selectedFacilities = data.selectedFacilities;
                    let totalBookingDuration = data.totalBookingDuration;
                    let extraHourCharge  = data.extraHourCharge ;
                    //let totalRentCharge = data.totalRentCharge;
                    let rentCharge = data.rentCharge;
                    let serviceCharge = data.serviceCharge;
                    let securityDeposit = data.securityDeposit;
                    let generatorcharge = data.generatorcharge;
                    let cgst = data.cgst;
                    let sgst = data.sgst;
                    let totalAmount = data.totalAmount;
                    //let Hourlycharge = data.totalHourlyCharge;
                   

                    $('#bookingDuration').text(totalBookingDuration);
                    $('#bookingDuration1').text(totalBookingDuration);
                    $('#receiptModal tbody').empty();

                    var facilityRow = '<tr>' +
                        '<td colspan="2" class="facility-name"><strong>Facilities Charges</strong></td>' +
                        '</tr>';

                    $('#receiptModal tbody').append(facilityRow);


                    for (const facilityName in selectedFacilities) {
                        if (selectedFacilities.hasOwnProperty(facilityName)) {

                            var row = '<tr>' +
                                '<td style="color:purple;" class="col-md-7"><em>' + facilityName + '</em></td>' +
                                '<td class="col-md-3 text-center">' + '₹' + selectedFacilities[facilityName].toFixed(2) + '</td>' +
                                '</tr>';
                            $('#receiptModal tbody').append(row);
                        }
                    }

                    var facilityRow = '<tr>' +
                        '<td colspan="2" class="facility-name"><strong>Taxes & Other Charges</strong></td>' +
                        '</tr>';

                    $('#receiptModal tbody').append(facilityRow);


                    var chargeRow6 = '<tr>' +
                        '<td style="color:purple; class="col-md-7"><em>Extra Hours Charges [₹4500/hr (above 6 hours)] :</em></td>' +
                        '<td class="col-md-3 text-center">' + '₹' + extraHourCharge.toFixed(2) + '</td>' +
                        '</tr>';
                    $('#receiptModal tbody').append(chargeRow6);


                    var chargeRow2 = '<tr>' +
                        '<td style="color:purple; class="col-md-7"><em>Generator Charge :</em></td>' +
                        '<td class="col-md-3 text-center">' + '₹' + generatorcharge.toFixed(2) + '</td>' +
                        '</tr>';
                    $('#receiptModal tbody').append(chargeRow2);

                    var chargeRow3 = '<tr>' +
                        '<td style="color:purple; class="col-md-7"><em>Security Deposit (20%) :</em></td>' +
                        '<td class="col-md-3 text-center">' + '₹' + securityDeposit.toFixed(2) + '</td>' +
                        '</tr>';
                    $('#receiptModal tbody').append(chargeRow3);

                    var chargeRow1 = '<tr>' +
                        '<td style="color:purple; class="col-md-7"><em>Service Charge (10%) :</em></td>' +
                        '<td class="col-md-3 text-center">' + '₹' + serviceCharge.toFixed(2) + '</td>' +
                        '</tr>';
                    $('#receiptModal tbody').append(chargeRow1);

                    var chargeRow4 = '<tr>' +
                        '<td style="color:purple; class="col-md-7"><em>CGST (9%) :</em></td>' +
                        '<td class="col-md-3 text-center">' + '₹' + cgst.toFixed(2) + '</td>' +
                        '</tr>';
                    $('#receiptModal tbody').append(chargeRow4);

                    var chargeRow5 = '<tr>' +
                        '<td style="color:purple; class="col-md-7"><em>SGST (9%) :</em></td>' +
                        '<td class="col-md-3 text-center">' + '₹' + sgst.toFixed(2) + '</td>' +
                        '</tr>';
                    $('#receiptModal tbody').append(chargeRow5);


                    var totalRow = '<tr>' +
                        '<td style="color:#472624;" class="col-md-7"><strong>Total Amount</strong></td>' +
                        '<td style="color:red;" class="col-md-3 text-center"><strong>' + '₹' + totalAmount.toFixed(2) + '</strong></td>' +
                        '</tr>';
                    $('#receiptModal tbody').append(totalRow);
                },
                error: function (xhr, status, errorThrown) {
                    console.log("Error details: ", errorThrown);
                    alert('Error fetching selected facilities and pricing.');
                }
            });
        });
    </script>
</head>
<body>

    <div style="align-content:center; text-align:center; width: 100%; max-width: 70%; margin: 20px auto;">
        <p>
            <label>@Model.UserDetails.CompanyName</label> के कार्यक्रम हेतु सुभाष यादव भवन स्थित आडिटोरियम हाल आरक्षण दिनांक <label>@Model.BookingDetails.FromDate.ToString("dd-MM-yyyy")</label> के संबंध में।
        </p>
    </div>


    <div style="width: 100%; max-width: 90%; margin: 20px auto;">
        <p>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<label>@Model.UserDetails.CompanyName</label> से प्राप्त पत्र दिनांक <label>@Model.BookingDetails.BookingDate.ToString("dd-MM-yyyy")</label> अवलोकनार्थ प्रस्तुत। उक्त पत्र द्वारा लिखा गया कि <label>@Model.UserDetails.CompanyName</label> द्वारा <label>@Model.BookingDetails.name</label> के कार्यक्रम हेतु
            दिनांक <label>@Model.BookingDetails.FromDate.ToString("dd-MM-yyyy")</label> को सुभाष यादव भवन स्थित आडिटोरियम
            हाल में दिनांक <label>@Model.BookingDetails.FromDate.ToString("dd-MM-yyyy")</label> समय <label>@Model.BookingDetails.startTime</label> बजे से दिनांक <label>@Model.BookingDetails.EndDate.ToString("dd-MM-yyyy")</label> समय <label>@Model.BookingDetails.endTime</label> बजे तक कुल <label id="bookingDuration1"></label> घंटे हेतु किराये से दिये जाने
            हेतु अनुरोध किया गया है। आडिटोरियम हाल का न्यूनतम <label id="bookingDuration"></label> घंटे का
            किराया निम्नानुसार है:-
        </p>
    </div>



    <div id="receiptModal" class="row">

        <table class="receipt-table">
            <thead id="receipt-table-head">
                <tr id="receipt-table-header-row">
                    <th id="product-header" class="receipt-table-header">Product</th>
                    <th id="price-header" class="receipt-table-header text-center">Price</th>
                </tr>
            </thead>
            <tbody id="receipt-table-body">
            </tbody>
        </table>

    </div>

    <div style="align-content:center; text-align:center; width: 100%; max-width: 70%; margin: 20px auto;">
        <p>
            दिनांक <label>@Model.BookingDetails.FromDate.ToString("dd-MM-yyyy")</label> समय <label>@Model.BookingDetails.startTime</label> बजे से दिनांक <label>@Model.BookingDetails.EndDate.ToString("dd-MM-yyyy")</label> समय <label>@Model.BookingDetails.endTime</label> बजे तक, आडिटोरियम हाल रिक्त है।
        </p>
    </div>

    <div style=" width: 100%; max-width: 90%; margin: 20px auto;">
        <p>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;अतः प्राप्त निर्देशानुसार <label>@Model.UserDetails.CompanyName</label> को सुभाष यादव भवन स्थित आडिटोरियम हाल मे कार्यक्रम दिनांक <label>@Model.BookingDetails.FromDate.ToString("dd-MM-yyyy")</label> समय <label>@Model.BookingDetails.startTime</label> बजे से दिनांक <label>@Model.BookingDetails.EndDate.ToString("dd-MM-yyyy")</label> समय <label>@Model.BookingDetails.endTime</label> को किराये से दिये जाने के संबंध में प्रकरण अवलोकनार्थ एवं निर्णयार्थ प्रस्तुत।
        </p>
    </div>

    <div style="display: flex; justify-content: space-between; width: 100%; max-width: 90%; margin: 20px auto; padding-top:25px">
        <p>
            विशेष कर्त्तव्यस्थ अधिकारी
        </p>

        <p>
            Date : <label>@Model.BookingDetails.BookingDate.ToString("dd-MM-yyyy")</label>
        </p>
    </div>

</body>
</html>
