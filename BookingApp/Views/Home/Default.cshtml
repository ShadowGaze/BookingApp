@using BookingApp
@using BookingApp.Models
@using Microsoft.AspNetCore.Mvc
@using DNTCaptcha.Core

@model BookingApp.Models.Login

@using Newtonsoft.Json

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Login</title>
    <link rel="stylesheet" href="~/css/Default.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/dntcaptcha/js/dntcaptcha.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <link rel="shortcut icon" href="~/images/favicon.png" />


    <script>
        
        $(document).ready(function () {
            const $body = $("body");
            const $modal = $(".modal");
            const $modalButton = $(".modal-button");
            const $closeButton = $(".close-button");
            const $scrollDown = $(".scroll-down");
            let isOpened = false;

            const openModal = () => {
                $modal.addClass("is-open");
                $body.css("overflow", "hidden");
            };

            const closeModal = () => {
                $modal.removeClass("is-open");
                $body.css("overflow", "initial");
            };

            $(window).on("scroll", function () {
                if ($(window).scrollTop() > $(window).height() / 3 && !isOpened) {
                    isOpened = true;
                    $scrollDown.hide();
                    openModal();
                }
            });

            $modalButton.on("click", function () {
                isOpened = true;
                $scrollDown.hide();
                openModal();
            });

            $closeButton.on("click", closeModal);

            $(document).on("keydown", function (evt) {
                if (evt.keyCode === 27) {
                    closeModal();
                }
            });

           
        });


    </script>

    
</head>
<body>
    
    <h1 style="text-align:center;">SAMANVAY BHAWAN TEST BOOKING APP</h1>
    <div class="scroll-down">
        SCROLL DOWN GITHUB
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
            <path d="M16 3C8.832031 3 3 8.832031 3 16s5.832031 13 13 13 13-5.832031 13-13S23.167969 3 16 3zm0 2c6.085938 0 11 4.914063 11 11 0 6.085938-4.914062 11-11 11-6.085937 0-11-4.914062-11-11C5 9.914063 9.914063 5 16 5zm-1 4v10.28125l-4-4-1.40625 1.4375L16 23.125l6.40625-6.40625L21 15.28125l-4 4V9z" />
        </svg>
    </div>
    <div class="container"></div>
    <div class="modal">
        <div class="modal-container">
            <div class="modal-left">

                <form asp-controller="Home">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="ModalOpenFlag" name="ModalOpenFlag" value="@ViewData["ModalOpenFlag"]" />

                    <h1 class="modal-title">LOGIN</h1>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="input-block">
                        <label asp-for="Username" class="input-label">Username :</label>
                        <input asp-for="Username" class="control" placeholder="Username" required/>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="input-block">

                        <label asp-for="Password" class="input-label">Password :</label>
                        <input asp-for="Password" type="password" class="control" placeholder="Password" required/>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="input-block" id="captcha" style="margin-top: 20px;">
                        <dnt-captcha asp-captcha-generator-max="999999"
                                     asp-captcha-generator-min="111111"
                                     asp-captcha-generator-language="English"
                                     asp-captcha-generator-display-mode="ShowDigits"
                                     asp-fore-color="#333333"
                                     asp-back-color="black"
                                     asp-font-name="Tahoma"
                                     asp-font-size="30"
                                     asp-use-relative-urls="true"
                                     asp-placeholder="Enter Captcha"
                                     asp-text-box-template="<span class='input-group-prepend'><span class='form-group-text'></span></span>{0}"
                                     asp-validation-message-class="text-danger"
                                     asp-use-noise="false">
                        </dnt-captcha>
                    </div>

                    <div class="modal-buttons">
                        <a href="#" class="">Forgot your password?</a>
                        <input class="input-button" type="submit" value="Login" />
                    </div>
                    <p class="sign-up">Don't have an account? <a asp-controller="Registers" asp-action="Register">Register</a></p>

                </form>
            </div>

            <div class="modal-right">
                <img src="~/images/claudio-schwarz-9chsb-ywam4-unsplash.jpg" />
                @* <img src="https://images.unsplash.com/photo-1512486130939-2c4f79935e4f?ixlib=rb-0.3.5&ixid=eyJhcHBfaWQiOjEyMDd9&s=dfd2ec5a01006fd8c4d7592a381d3776&auto=format&fit=crop&w=1000&q=80" alt=""> *@
            </div>
            <button class="icon-button close-button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50">
                    <path d="M 25 3 C 12.86158 3 3 12.86158 3 25 C 3 37.13842 12.86158 47 25 47 C 37.13842 47 47 37.13842 47 25 C 47 12.86158 37.13842 3 25 3 z M 25 5 C 36.05754 5 45 13.94246 45 25 C 45 36.05754 36.05754 45 25 45 C 13.94246 45 5 36.05754 5 25 C 5 13.94246 13.94246 5 25 5 z M 16.990234 15.990234 A 1.0001 1.0001 0 0 0 16.292969 17.707031 L 23.585938 25 L 16.292969 32.292969 A 1.0001 1.0001 0 1 0 17.707031 33.707031 L 25 26.414062 L 32.292969 33.707031 A 1.0001 1.0001 0 1 0 33.707031 32.292969 L 26.414062 25 L 33.707031 17.707031 A 1.0001 1.0001 0 0 0 32.980469 15.990234 A 1.0001 1.0001 0 0 0 32.292969 16.292969 L 25 23.585938 L 17.707031 16.292969 A 1.0001 1.0001 0 0 0 16.990234 15.990234 z"></path>
                </svg>
            </button>

            

        </div>

        <button class="modal-button">Click here to login</button>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }


</body>
</html>




